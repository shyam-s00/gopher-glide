---
import HeroVisual from './HeroVisual.astro';
---
<div class="hero-container not-content">
  <div class="hero-content">
    <a href="#whats-new" class="hero-pill">
      <span class="pill-badge">New in v1.5</span>
      <span>Built-in Autopilot, MCP &amp; JetBrains Air / VS Code Agents &rarr;</span>
    </a>

    <h1 class="hero-title">Find your API's breaking point, from your terminal, IDE, or AI agent.</h1>
    <p class="hero-subtitle">Reuse your existing <code>.http</code> files with zero scripting. Let the built-in autopilot discover your capacity ceiling, catch payload and schema regressions before prod, and give your AI agent a load tester with hard safety caps.</p>

    <div class="hero-stats">
      <span class="stat-chip">⚡ 30,000+ RPS</span>
      <span class="stat-chip">🎯 Built-in Autopilot</span>
      <span class="stat-chip">🤖 MCP &amp; ACP Agents</span>
      <span class="stat-chip">✦ Zero scripting</span>
    </div>

    <div class="hero-install-box" data-install-tabs>
      <div class="install-tabs" role="tablist" aria-label="Install methods">
        <button type="button" class="install-tab active" role="tab" aria-selected="true" data-tab="brew">Homebrew</button>
        <button type="button" class="install-tab" role="tab" aria-selected="false" data-tab="docker">Docker</button>
        <button type="button" class="install-tab" role="tab" aria-selected="false" data-tab="ide">IDE Plugins</button>
        <button type="button" class="install-tab" role="tab" aria-selected="false" data-tab="bin">Binaries</button>
      </div>

      <div class="install-panel active" data-panel="brew">
        <code class="install-cmd">brew install shyam-s00/tap/gg</code>
        <button type="button" class="copy-btn" data-copy="brew install shyam-s00/tap/gg" aria-label="Copy Homebrew install command">Copy</button>
      </div>

      <div class="install-panel" data-panel="docker">
        <code class="install-cmd">docker pull ghcr.io/shyam-s00/gopher-glide:latest</code>
        <button type="button" class="copy-btn" data-copy="docker pull ghcr.io/shyam-s00/gopher-glide:latest" aria-label="Copy Docker pull command">Copy</button>
      </div>

      <div class="install-panel install-links" data-panel="ide">
        <a href="https://plugins.jetbrains.com/plugin/30983-gopher-glide" class="install-link-btn" target="_blank" rel="noopener noreferrer">JetBrains Marketplace &rarr;</a>
        <a href="https://marketplace.visualstudio.com/items?itemName=gopherglide.gg-plugin" class="install-link-btn" target="_blank" rel="noopener noreferrer">VS Code Marketplace &rarr;</a>
        <a href="https://open-vsx.org/extension/gopherglide/gg-plugin" class="install-link-btn" target="_blank" rel="noopener noreferrer">Open VSX &rarr;</a>
      </div>

      <div class="install-panel install-links" data-panel="bin">
        <span class="install-note">Single static binary for macOS, Linux &amp; Windows:</span>
        <a href="https://github.com/shyam-s00/gopher-glide/releases/latest" class="install-link-btn" target="_blank" rel="noopener noreferrer">Download from GitHub Releases &rarr;</a>
      </div>
    </div>

    <div class="hero-buttons">
      <a href="/getting-started" class="btn btn-primary">Get Started in 30s &rarr;</a>
    </div>

    <div class="github-stats" id="gh-stats" style="visibility:hidden">
      <a href="https://github.com/shyam-s00/gopher-glide/stargazers" class="gh-stat" id="gh-stars" target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
        <span id="gh-stars-count"></span>
      </a>
      <a href="https://github.com/shyam-s00/gopher-glide/network/members" class="gh-stat" id="gh-forks" target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"/></svg>
        <span id="gh-forks-count"></span>
      </a>
      <a href="https://github.com/shyam-s00/gopher-glide/releases/latest" class="gh-stat" id="gh-version" target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M2.75 1h10.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 13.25 13H9.06l.038.027c.6.43.913 1.022.913 1.723v.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1-.75-.75v-.5c0-.701.313-1.292.912-1.723L6.94 13H2.75A1.75 1.75 0 0 1 1 11.25v-8.5C1 1.784 1.784 1 2.75 1Zm0 1.5a.25.25 0 0 0-.25.25v8.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-8.5a.25.25 0 0 0-.25-.25Z"/></svg>
        <span id="gh-version-tag"></span>
      </a>
    </div>
  </div>
  <div class="hero-visual-wrap">
    <HeroVisual />
  </div>
</div>

<style>
  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 2rem 2rem;
    background: radial-gradient(circle at top, rgba(198, 160, 246, 0.12) 0%, transparent 55%);
  }
  .hero-content {
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-visual-wrap {
    width: 100%;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.3rem 0.9rem 0.3rem 0.4rem;
    margin-bottom: 1.4rem;
    border-radius: 999px;
    background: var(--gg-glass-bg);
    border: 1px solid var(--gg-glass-border);
    color: var(--sl-color-gray-1);
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: none;
    backdrop-filter: blur(8px);
    transition: border-color 0.2s, transform 0.2s;
  }
  .hero-pill:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-1px);
  }
  .pill-badge {
    padding: 0.12rem 0.55rem;
    border-radius: 999px;
    background: var(--sl-color-accent);
    color: var(--sl-color-bg);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    max-width: 820px;
    margin: 0 0 1.25rem 0;
    background: linear-gradient(100deg, var(--sl-color-text) 10%, var(--sl-color-accent) 60%, var(--gg-info) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-subtitle {
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    margin: 0 0 1.6rem 0;
    max-width: 650px;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem;
    margin-bottom: 1.6rem;
  }
  .stat-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.32rem 0.8rem;
    border-radius: 999px;
    font-size: 0.83rem;
    font-weight: 600;
    background: var(--gg-glass-bg);
    border: 1px solid var(--gg-glass-border);
    color: var(--sl-color-text);
    backdrop-filter: blur(8px);
  }

  /* Tabbed install box */
  .hero-install-box {
    width: 100%;
    max-width: 560px;
    margin-bottom: 1.6rem;
    border-radius: 12px;
    background: var(--gg-glass-bg);
    border: 1px solid var(--gg-glass-border);
    backdrop-filter: blur(10px);
    overflow: hidden;
    box-shadow: 0 6px 24px var(--gg-glass-shadow);
  }
  .install-tabs {
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--gg-glass-border);
    background: color-mix(in srgb, var(--sl-color-bg-nav) 65%, transparent);
  }
  .install-tab {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0.38rem 0.6rem;
    border: none;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--sl-color-gray-2);
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.25;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .install-tab:hover {
    color: var(--sl-color-text);
  }
  .install-tab.active {
    color: var(--sl-color-accent);
    border-bottom-color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
  }
  .install-panel {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0;
    padding: 0.65rem 1rem;
    min-height: 2.75rem;
  }
  .install-panel.active {
    display: flex;
  }
  .install-cmd {
    font-family: var(--__sl-font-mono, monospace);
    font-size: 0.88rem;
    color: var(--sl-color-text);
    background: none;
    padding: 0;
    overflow-x: auto;
    white-space: nowrap;
  }
  .install-cmd::before {
    content: '$ ';
    color: var(--sl-color-gray-3);
  }
  .install-links {
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
  }
  .install-note {
    font-size: 0.84rem;
    color: var(--sl-color-gray-2);
  }
  .install-link-btn {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--sl-color-accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .install-link-btn:hover {
    text-decoration: underline;
  }

  .copy-btn {
    flex-shrink: 0;
    padding: 0.25rem 0.7rem;
    border-radius: 6px;
    border: 1px solid var(--gg-glass-border);
    background: transparent;
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .copy-btn:hover {
    color: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 1.25rem;
  }
  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn-primary {
    background: var(--sl-color-accent);
    color: var(--sl-color-bg);
  }
  .btn-primary:hover {
    background: var(--sl-color-accent-high);
    transform: translateY(-2px);
  }
  .btn-secondary {
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
    border: 1px solid var(--sl-color-hairline);
  }
  .btn-secondary:hover {
    background: var(--sl-color-hairline);
    transform: translateY(-2px);
  }

  .github-stats {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .gh-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.2s;
  }
  .gh-stat:hover {
    color: var(--sl-color-accent);
  }
  .gh-stat svg {
    flex-shrink: 0;
    opacity: 0.7;
  }

  @media (max-width: 900px) {
    .hero-container {
      padding: 2.5rem 1.25rem 3rem;
      gap: 2rem;
    }
    .hero-subtitle {
      max-width: none;
    }
    .hero-title {
      font-size: 2.15rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-install-tabs]').forEach((box) => {
    const tabs = box.querySelectorAll<HTMLButtonElement>('[data-tab]');
    const panels = box.querySelectorAll<HTMLElement>('[data-panel]');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const key = tab.dataset.tab;
        tabs.forEach((t) => {
          const active = t.dataset.tab === key;
          t.classList.toggle('active', active);
          t.setAttribute('aria-selected', String(active));
        });
        panels.forEach((p) => p.classList.toggle('active', p.dataset.panel === key));
      });
    });

    box.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Copied';
          setTimeout(() => { btn.textContent = 'Copy'; }, 1600);
        } catch {
          btn.textContent = 'Press Ctrl+C';
        }
      });
    });
  });
</script>

<script>
  const CACHE_KEY = 'gg_gh_stats';
  const CACHE_TTL = 60 * 60 * 1000; // 1 hour

  async function loadGhStats() {
    let data: { stars: number; forks: number; version: string; ts: number } | null = null;

    try {
      const raw = localStorage.getItem(CACHE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Date.now() - parsed.ts < CACHE_TTL) data = parsed;
      }
    } catch {}

    if (!data) {
      try {
        const [repoRes, releaseRes] = await Promise.all([
          fetch('https://api.github.com/repos/shyam-s00/gopher-glide', {
            headers: { Accept: 'application/vnd.github+json' },
          }),
          fetch('https://api.github.com/repos/shyam-s00/gopher-glide/releases/latest', {
            headers: { Accept: 'application/vnd.github+json' },
          }),
        ]);
        if (!repoRes.ok || !releaseRes.ok) return;
        const repo = await repoRes.json();
        const release = await releaseRes.json();
        data = {
          stars: repo.stargazers_count,
          forks: repo.forks_count,
          version: release.tag_name,
          ts: Date.now(),
        };
        try { localStorage.setItem(CACHE_KEY, JSON.stringify(data)); } catch {}
      } catch {
        return;
      }
    }

    document.getElementById('gh-stars-count')!.textContent = `${data.stars.toLocaleString()} stars`;
    document.getElementById('gh-forks-count')!.textContent = `${data.forks} forks`;
    document.getElementById('gh-version-tag')!.textContent = data.version;
    document.getElementById('gh-stats')!.style.visibility = 'visible';
  }

  loadGhStats();
</script>
