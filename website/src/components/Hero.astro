---
import HeroVisual from './HeroVisual.astro';
---
<div class="hero-container">
  <div class="hero-content">
    <h1 class="hero-title">High-fidelity API traffic simulation from your IDE.</h1>
    <p class="hero-subtitle">Gopher-Glide (gg) is an open-source, high-fidelity API traffic simulator. Move beyond brute-force load testing with native IDE integration, zero-config profiles, and an interactive TUI that lets you inject chaos in real-time.</p>

    <div class="hero-stats">
      <span class="stat-chip">⚡ 30,000+ RPS</span>
      <span class="stat-chip">✦ Zero Scripting</span>
      <span class="stat-chip">100% Lock-Free</span>
    </div>

    <div class="hero-install">
      <code>brew install shyam-s00/tap/gg</code>
      <a href="/getting-started/#1-install" class="hero-install-alt">other install options &rarr;</a>
    </div>

    <div class="hero-buttons">
      <a href="/getting-started" class="btn btn-primary">Get Started &rarr;</a>
      <a href="https://github.com/shyam-s00/gopher-glide" class="btn btn-secondary">View on GitHub</a>
    </div>

    <div class="github-stats" id="gh-stats" style="visibility:hidden">
      <a href="https://github.com/shyam-s00/gopher-glide/stargazers" class="gh-stat" id="gh-stars" target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
        <span id="gh-stars-count"></span>
      </a>
      <a href="https://github.com/shyam-s00/gopher-glide/network/members" class="gh-stat" id="gh-forks" target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"/></svg>
        <span id="gh-forks-count"></span>
      </a>
      <a href="https://github.com/shyam-s00/gopher-glide/releases/latest" class="gh-stat" id="gh-version" target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M2.75 1h10.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 13.25 13H9.06l.038.027c.6.43.913 1.022.913 1.723v.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1-.75-.75v-.5c0-.701.313-1.292.912-1.723L6.94 13H2.75A1.75 1.75 0 0 1 1 11.25v-8.5C1 1.784 1.784 1 2.75 1Zm0 1.5a.25.25 0 0 0-.25.25v8.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-8.5a.25.25 0 0 0-.25-.25Z"/></svg>
        <span id="gh-version-tag"></span>
      </a>
    </div>
  </div>
  <div class="hero-visual-wrap">
    <HeroVisual />
  </div>
</div>

<style>
  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 3rem;
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 2rem;
    background: radial-gradient(circle at top, rgba(198, 160, 246, 0.1) 0%, transparent 50%);
  }
  .hero-content {
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-visual-wrap {
    width: 100%;
  }
  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    background: -webkit-linear-gradient(45deg, var(--sl-color-text), var(--sl-color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--sl-color-gray-2);
    margin-bottom: 2rem;
    max-width: 640px;
  }

  /* Inline feature chips — sit between subtitle and CTA buttons */
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .stat-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    background: var(--gg-glass-bg);
    border: 1px solid var(--gg-glass-border);
    color: var(--sl-color-text);
    backdrop-filter: blur(8px);
  }

  /* Copyable install command — sits between the stat chips and CTA buttons */
  .hero-install {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 1.75rem;
    padding: 0.6rem 1.1rem;
    border-radius: 8px;
    background: var(--gg-glass-bg);
    border: 1px solid var(--gg-glass-border);
    backdrop-filter: blur(8px);
  }
  .hero-install code {
    font-family: var(--__sl-font-mono, monospace);
    font-size: 0.9rem;
    color: var(--sl-color-text);
    background: none;
    padding: 0;
  }
  .hero-install code::before {
    content: '$ ';
    color: var(--sl-color-gray-2);
  }
  .hero-install-alt {
    font-size: 0.8rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .hero-install-alt:hover {
    color: var(--sl-color-accent);
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 1.25rem;
  }
  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn-primary {
    background: var(--sl-color-accent);
    color: var(--sl-color-bg);
  }
  .btn-primary:hover {
    background: var(--sl-color-accent-high);
    transform: translateY(-2px);
  }
  .btn-secondary {
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
    border: 1px solid var(--sl-color-hairline);
  }
  .btn-secondary:hover {
    background: var(--sl-color-hairline);
    transform: translateY(-2px);
  }

  /* GitHub live stats row */
  .github-stats {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .gh-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.2s;
  }
  .gh-stat:hover {
    color: var(--sl-color-accent);
  }
  .gh-stat svg {
    flex-shrink: 0;
    opacity: 0.7;
  }

  @media (max-width: 900px) {
    .hero-container {
      padding: 3rem 1.5rem;
      gap: 2.5rem;
    }
    .hero-subtitle {
      max-width: none;
    }
    .hero-title {
      font-size: 2.25rem;
    }
  }
</style>

<script>
  const CACHE_KEY = 'gg_gh_stats';
  const CACHE_TTL = 60 * 60 * 1000; // 1 hour

  async function loadGhStats() {
    let data: { stars: number; forks: number; version: string; ts: number } | null = null;

    try {
      const raw = localStorage.getItem(CACHE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Date.now() - parsed.ts < CACHE_TTL) data = parsed;
      }
    } catch {}

    if (!data) {
      try {
        const [repoRes, releaseRes] = await Promise.all([
          fetch('https://api.github.com/repos/shyam-s00/gopher-glide', {
            headers: { Accept: 'application/vnd.github+json' },
          }),
          fetch('https://api.github.com/repos/shyam-s00/gopher-glide/releases/latest', {
            headers: { Accept: 'application/vnd.github+json' },
          }),
        ]);
        if (!repoRes.ok || !releaseRes.ok) return;
        const repo = await repoRes.json();
        const release = await releaseRes.json();
        data = {
          stars: repo.stargazers_count,
          forks: repo.forks_count,
          version: release.tag_name,
          ts: Date.now(),
        };
        try { localStorage.setItem(CACHE_KEY, JSON.stringify(data)); } catch {}
      } catch {
        return;
      }
    }

    document.getElementById('gh-stars-count')!.textContent = `${data.stars.toLocaleString()} stars`;
    document.getElementById('gh-forks-count')!.textContent = `${data.forks} forks`;
    document.getElementById('gh-version-tag')!.textContent = data.version;
    document.getElementById('gh-stats')!.style.visibility = 'visible';
  }

  loadGhStats();
</script>
