---
export interface Props {
  title: string;
  reverse?: boolean;
  // Drop the glass frame when the visual brings its own (terminals, panes).
  flush?: boolean;
  id?: string;
  eyebrow?: string;
  // Text on top, visual full width below: for wide terminal output.
  stacked?: boolean;
}
const { title, reverse = false, flush = false, id, eyebrow, stacked = false } = Astro.props;
---
<div class={`glass-feature-row ${reverse ? 'reverse' : ''} ${stacked ? 'stacked' : ''}`} id={id}>
  <div class="feature-text">
    {eyebrow && <span class="gg-eyebrow">{eyebrow}</span>}
    <h2>{title}</h2>
    <div class="text-content">
      <slot name="text" />
    </div>
  </div>
  <div class="feature-visual">
    <div class={flush ? 'flush-panel' : 'glass-panel'}>
      <slot name="visual" />
    </div>
  </div>
</div>

<style>
  .glass-feature-row {
    display: flex;
    gap: 3rem;
    align-items: center;
    padding: 2.25rem 2rem;
    max-width: 1200px;
    margin: 0 auto !important;
  }
  .glass-feature-row.reverse {
    flex-direction: row-reverse;
  }
  .glass-feature-row.stacked {
    flex-direction: column;
    align-items: stretch;
    gap: 1.25rem;
  }
  .glass-feature-row.stacked .feature-text {
    max-width: 780px;
  }
  .feature-text {
    flex: 1;
    min-width: 0;
  }
  .feature-text h2 {
    font-size: 2.05rem;
    margin: 0 0 0.85rem 0 !important;
    color: var(--sl-color-text);
    font-weight: 700;
    line-height: 1.2;
  }
  .text-content :global(p) {
    font-size: 1.05rem;
    color: var(--sl-color-gray-2);
    line-height: 1.58;
    margin: 0 0 0.75rem 0;
  }
  .text-content :global(p:last-child) {
    margin-bottom: 0;
  }
  .text-content :global(strong) {
    color: var(--sl-color-text);
  }
  .feature-visual {
    flex: 1;
    width: 100%;
    min-width: 0;
    margin-top: 0 !important;
  }
  .flush-panel {
    width: 100%;
  }
  .text-content :global(.feature-points) {
    list-style: none;
    margin: 0 0 0.9rem;
    padding: 0;
  }
  .text-content :global(.feature-points li) {
    position: relative;
    margin: 0 0 0.45rem;
    padding-left: 1.6rem;
    color: var(--sl-color-gray-2);
    line-height: 1.5;
  }
  .text-content :global(.feature-points li::before) {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--gg-ok);
    font-weight: 800;
  }
  .text-content :global(.feature-link) {
    display: inline-block;
    margin-right: 1.25rem;
    color: var(--sl-color-accent);
    font-weight: 600;
    text-decoration: none;
  }
  .text-content :global(.feature-link:hover) {
    text-decoration: underline;
  }
  .glass-panel {
    background: var(--gg-glass-bg);
    backdrop-filter: blur(12px);
    border: 1px solid var(--gg-glass-border);
    border-radius: 12px;
    padding: 0.75rem;
    box-shadow: 0 8px 32px var(--gg-glass-shadow);
    overflow: hidden;
  }
  @media (max-width: 768px) {
    .glass-feature-row, .glass-feature-row.reverse {
      flex-direction: column;
      gap: 1.5rem;
      padding: 1.75rem 1.25rem;
    }
  }
</style>
