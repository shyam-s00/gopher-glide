---
const stacks = [
  'Node.js',
  'Python',
  'Java',
  'Kotlin',
  '.NET',
  'Rails',
  'PHP',
  'Rust',
  'Elixir',
  'Go',
];
---
<section class="any-stack-strip" aria-label="Supported backend stacks">
  <div class="strip-inner">
    <p class="strip-lead">
      <strong>Any backend, zero code changes.</strong>
      <span>One static binary, no SDKs, no runtime. If it speaks HTTP, <code>gg</code> can test it.</span>
      <a href="/any-backend" class="strip-link">Stack guide &rarr;</a>
    </p>
    <ul class="any-stack-chips" aria-label="Examples of backends gg can test">
      {stacks.map((name) => <li class="any-stack-chip">{name}</li>)}
      <li class="any-stack-chip any-stack-chip-more">+ any HTTP API</li>
    </ul>
  </div>
</section>

<style>
  .any-stack-strip {
    max-width: 1040px;
    margin: 0 auto 2rem auto;
    padding: 0 1.5rem;
  }
  .strip-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.35rem 1.75rem;
    border-radius: var(--gg-radius);
    background: var(--gg-glass-bg);
    border: 1px solid var(--gg-glass-border);
    backdrop-filter: blur(10px);
    text-align: center;
  }
  .strip-lead {
    margin: 0;
    font-size: 0.95rem;
    color: var(--sl-color-gray-2);
    line-height: 1.5;
  }
  .strip-lead strong {
    color: var(--sl-color-text);
    margin-right: 0.35rem;
  }
  .strip-link {
    margin-left: 0.5rem;
    color: var(--sl-color-accent);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .strip-link:hover {
    text-decoration: underline;
  }
  .any-stack-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .any-stack-chip {
    margin: 0;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--sl-color-gray-1);
    background: color-mix(in srgb, var(--sl-color-bg-nav) 75%, transparent);
    border: 1px solid var(--gg-glass-border);
  }
  .any-stack-chip-more {
    color: var(--sl-color-accent);
    border-color: color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
  }
</style>
