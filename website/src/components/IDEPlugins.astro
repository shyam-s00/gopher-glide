---
---
<section class="ide-plugins-section">
  <div class="ide-plugins-header">
    <h2 class="ide-plugins-title">Install for Your IDE</h2>
    <p class="ide-plugins-subtitle">Native plugins for every major editor — same workflow, same features, wherever you code.</p>
  </div>
  <div class="ide-plugins-grid">

    <a href="https://plugins.jetbrains.com/plugin/30983-gopher-glide" class="plugin-card" target="_blank" rel="noopener noreferrer">
      <div class="plugin-card-icon">
        <img src="/assets/icon-jetbrains.svg" alt="JetBrains" width="40" height="40" />
      </div>
      <div class="plugin-card-body">
        <span class="plugin-card-name">JetBrains</span>
        <span class="plugin-card-desc">IntelliJ, GoLand, WebStorm, Rider &amp; more</span>
      </div>
      <span class="plugin-card-cta">Install &rarr;</span>
    </a>

    <a href="https://marketplace.visualstudio.com/items?itemName=gopherglide.gg-plugin" class="plugin-card" target="_blank" rel="noopener noreferrer">
      <div class="plugin-card-icon">
        <img src="/assets/icon-vscode.svg" alt="VS Code" width="40" height="40" />
      </div>
      <div class="plugin-card-body">
        <span class="plugin-card-name">VS Code</span>
        <span class="plugin-card-desc">Visual Studio Code Marketplace</span>
      </div>
      <span class="plugin-card-cta">Install &rarr;</span>
    </a>

    <a href="https://open-vsx.org/extension/gopherglide/gg-plugin" class="plugin-card" target="_blank" rel="noopener noreferrer">
      <div class="plugin-card-icon">
        <img src="/assets/icon-openvsx.png" alt="Open VSX" width="40" height="40" />
      </div>
      <div class="plugin-card-body">
        <span class="plugin-card-name">Open VSX</span>
        <span class="plugin-card-desc">VSCodium, Gitpod, Eclipse Theia &amp; more</span>
      </div>
      <span class="plugin-card-cta">Install &rarr;</span>
    </a>

  </div>
</section>

<style>
  .ide-plugins-section {
    max-width: 900px;
    margin: 0 auto 2rem auto;
    padding: 0 1.5rem;
  }
  .ide-plugins-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .ide-plugins-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--sl-color-text);
    margin-bottom: 0.5rem;
  }
  .ide-plugins-subtitle {
    color: var(--sl-color-gray-2);
    font-size: 1rem;
    max-width: 480px;
    margin: 0 auto;
  }
  .ide-plugins-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .plugin-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: 1.5rem 1.25rem;
    background: var(--gg-glass-bg);
    backdrop-filter: blur(12px);
    border: 1px solid var(--gg-glass-border);
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    box-shadow: 0 4px 20px var(--gg-glass-shadow);
  }
  .plugin-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 40px var(--gg-glass-shadow-hover);
    border-color: var(--sl-color-accent);
  }
  .plugin-card-icon {
    flex-shrink: 0;
  }
  .plugin-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .plugin-card-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--sl-color-text);
  }
  .plugin-card-desc {
    font-size: 0.82rem;
    color: var(--sl-color-gray-2);
    line-height: 1.4;
  }
  .plugin-card-cta {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--sl-color-accent);
    margin-top: auto;
  }
  @media (max-width: 640px) {
    .ide-plugins-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
