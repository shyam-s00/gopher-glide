---
const metrics = [
  {
    title: 'Goodput at 30,000 RPS Saturation',
    sub: 'Higher is better (Adaptive Backpressure keeps target alive)',
    ggLabel: 'gg',
    ggVal: '76,140 ok reqs',
    ggPct: 100,
    otherLabel: 'k6',
    otherVal: '25,753 ok reqs',
    otherPct: 34,
    badge: '~3x more goodput',
  },
  {
    title: 'Peak Memory at 10,000 RPS',
    sub: 'Lower is better (Lock-free Go actors vs JS VMs)',
    ggLabel: 'gg',
    ggVal: '186 MB',
    ggPct: 23,
    otherLabel: 'k6',
    otherVal: '796 MB',
    otherPct: 100,
    badge: '4.2x less RAM',
  },
  {
    title: 'Peak Memory at 30,000 RPS Saturation',
    sub: 'Lower is better (10k concurrent blocked sockets)',
    ggLabel: 'gg',
    ggVal: '1.42 GB',
    ggPct: 60,
    otherLabel: 'k6',
    otherVal: '2.38 GB',
    otherPct: 100,
    badge: '40% less RAM',
  },
];
---
<div class="bench-card not-content">
  <div class="bench-header">
    <strong>gg vs. k6</strong>
    <span class="bench-zero">0 allocs/op hot path</span>
  </div>

  <div class="bench-list">
    {metrics.map((m) => (
      <div class="bench-item">
        <div class="bench-top">
          <div>
            <div class="bench-name">{m.title}</div>
            <div class="bench-sub">{m.sub}</div>
          </div>
          <span class="bench-badge">{m.badge}</span>
        </div>

        <div class="bench-bars">
          <div class="bar-row">
            <span class="bar-who gg">{m.ggLabel}</span>
            <div class="bar-track">
              <div class="bar-fill gg" style={`width: ${m.ggPct}%`}></div>
            </div>
            <span class="bar-num gg">{m.ggVal}</span>
          </div>
          <div class="bar-row">
            <span class="bar-who other">{m.otherLabel}</span>
            <div class="bar-track">
              <div class="bar-fill other" style={`width: ${m.otherPct}%`}></div>
            </div>
            <span class="bar-num other">{m.otherVal}</span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="bench-foot">
    <span>Measured locally on Apple M4 Pro (darwin/arm64).</span>
    <a href="/benchmarks">Full methodology &rarr;</a>
  </div>
</div>

<style>
  .bench-card {
    background: #181926;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 12px;
    padding: 1.25rem;
    color: #cad3f5;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.35);
  }
  .bench-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-bottom: 0.85rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid #363a4f;
    font-size: 0.95rem;
  }
  .bench-zero {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: rgba(166, 218, 149, 0.14);
    border: 1px solid #a6da95;
    color: #a6da95;
    font-family: var(--__sl-font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
  }
  .bench-list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .bench-item {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .bench-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .bench-name {
    font-size: 0.88rem;
    font-weight: 700;
    color: #f5f7ff;
  }
  .bench-sub {
    font-size: 0.74rem;
    color: #939ab7;
  }
  .bench-badge {
    flex-shrink: 0;
    padding: 0.15rem 0.55rem;
    border-radius: 6px;
    background: rgba(198, 160, 246, 0.16);
    color: #c6a0f6;
    font-size: 0.74rem;
    font-weight: 700;
  }
  .bench-bars {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .bar-row {
    display: grid;
    grid-template-columns: 28px 1fr 112px;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--__sl-font-mono, monospace);
    font-size: 0.75rem;
  }
  .bar-who { font-weight: 700; }
  .bar-who.gg { color: #c6a0f6; }
  .bar-who.other { color: #939ab7; }
  .bar-track {
    height: 10px;
    border-radius: 999px;
    background: #24273a;
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    border-radius: 999px;
  }
  .bar-fill.gg {
    background: linear-gradient(90deg, #c6a0f6, #8aadf4);
  }
  .bar-fill.other {
    background: #5b6078;
  }
  .bar-num { text-align: right; font-weight: 700; }
  .bar-num.gg { color: #a6da95; }
  .bar-num.other { color: #939ab7; }

  .bench-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding-top: 0.75rem;
    border-top: 1px solid #363a4f;
    font-size: 0.76rem;
    color: #939ab7;
  }
  .bench-foot a {
    color: #c6a0f6;
    font-weight: 600;
    text-decoration: none;
  }
  .bench-foot a:hover { text-decoration: underline; }
</style>
