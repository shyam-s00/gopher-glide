---
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import type { Props } from '@astrojs/starlight/props';

// Bump the version when a new gg release ships.
const release = 'v1.5';
---
<a href="/#whats-new" class="release-badge" title={`What's new in gg ${release}`}>
  <span class="release-badge-dot" aria-hidden="true"></span>{release} <span class="release-badge-text">What's new</span>
</a>
<Default {...Astro.props} />

<style>
  .release-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-right: 0.35rem;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 999px;
    color: var(--sl-color-accent);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }
  .release-badge:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
  }
  .release-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gg-ok);
  }
  @media (max-width: 1000px) {
    .release-badge-text { display: none; }
  }
  @media (max-width: 640px) {
    .release-badge { display: none; }
  }
</style>
