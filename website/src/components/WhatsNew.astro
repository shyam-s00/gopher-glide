---
const release = 'v1.5';
const tagline = 'Whether you are preparing for a launch, letting an AI agent verify its own code, or gating a PR in CI, gg fits the workflow you already have.';

const workflows = [
  {
    icon: '🎯',
    eyebrow: 'Autopilot',
    title: 'Find your breaking point automatically',
    desc: 'Stop hand-tuning ramp scripts. --autopilot find-ceiling steps load up, backs off the second p99 or error limits trip, confirms the rate that held, and writes a shareable HTML or Markdown report. Deterministic Go, zero LLM cost.',
    code: 'gg --http-file api.http --autopilot find-ceiling --max-p99 200ms',
    href: '#autopilot-demo',
    cta: 'See autopilot in action',
  },
  {
    icon: '🤖',
    eyebrow: 'MCP & ACP Agents',
    title: 'Let your AI agent load-test safely',
    desc: 'One command wires gg into Claude Code, Cursor, VS Code Copilot, JetBrains Air, and Zed. Agents dry-run, steer, and triage regressions through 11 MCP tools, bounded by hard caps on RPS, duration, and target hosts.',
    code: 'gg mcp init',
    href: '#agents-demo',
    cta: 'See AI agent workflows',
  },
  {
    icon: '🖥️',
    eyebrow: 'IDE Cockpit',
    title: 'Run, steer & diff inside your editor',
    desc: 'Click a gutter icon on any .http file in IntelliJ, GoLand, PyCharm, WebStorm, Rider, or VS Code. Watch live RPS and latency curves, nudge load up or down, drop timeline markers, and diff snapshots side-by-side.',
    code: 'JetBrains Marketplace · VS Code · Open VSX',
    href: '#ide-cockpit',
    cta: 'Explore IDE plugins',
  },
  {
    icon: '🔬',
    eyebrow: 'Semantic X-Ray',
    title: 'Catch payload & schema drift in CI',
    desc: 'Know why p99 spiked, not just when. gg snap catches silent JSON schema drift, missing pagination (array bloat), and latency regressions before they hit production, and exports single-file HTML Mission Reports.',
    code: 'gg snap assert baseline current --max-array-bloat 30',
    href: '#snap-xray',
    cta: 'See snapshot diffing',
  },
];
---
<section class="whats-new-section" id="whats-new" aria-labelledby="whats-new-title">
  <div class="whats-new-header">
    <span class="whats-new-badge">What you can do with gg {release}</span>
    <h2 class="whats-new-title" id="whats-new-title">Four workflows. <span class="gg-gradient-text">One binary.</span></h2>
    <p class="whats-new-subtitle">{tagline}</p>
  </div>

  <div class="workflows-grid">
    {workflows.map((w) => (
      <a href={w.href} class="workflow-card">
        <div class="workflow-top">
          <span class="workflow-icon" aria-hidden="true">{w.icon}</span>
          <span class="workflow-eyebrow">{w.eyebrow}</span>
        </div>
        <h3 class="workflow-title">{w.title}</h3>
        <p class="workflow-desc">{w.desc}</p>
        <code class="workflow-code">{w.code}</code>
        <span class="workflow-cta">{w.cta} &rarr;</span>
      </a>
    ))}
  </div>
</section>

<style>
  .whats-new-section {
    max-width: 1040px;
    margin: 0 auto 2rem auto;
    padding: 0 1.5rem;
    scroll-margin-top: 5rem;
  }
  .whats-new-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .whats-new-badge {
    display: inline-block;
    padding: 0.2rem 0.85rem;
    margin-bottom: 0.75rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 999px;
    background: var(--gg-glass-bg);
    color: var(--sl-color-accent);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .whats-new-title {
    font-size: 2.05rem;
    font-weight: 800;
    color: var(--sl-color-text);
    margin: 0 0 0.5rem 0 !important;
  }
  .whats-new-subtitle {
    color: var(--sl-color-gray-2);
    font-size: 1.03rem;
    line-height: 1.55;
    max-width: 640px;
    margin: 0 auto;
  }

  .workflows-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.15rem;
  }
  .workflow-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.5rem;
    background: var(--gg-glass-bg);
    backdrop-filter: blur(12px);
    border: 1px solid var(--gg-glass-border);
    border-radius: var(--gg-radius);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    box-shadow: 0 4px 20px var(--gg-glass-shadow);
  }
  .workflow-card:hover,
  .workflow-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 14px 40px var(--gg-glass-shadow-hover);
    border-color: var(--sl-color-accent);
  }
  .workflow-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .workflow-icon {
    font-size: 1.45rem;
    line-height: 1;
  }
  .workflow-eyebrow {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sl-color-accent);
  }
  .workflow-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--sl-color-text);
    margin: 0.15rem 0 0 0;
    line-height: 1.3;
  }
  .workflow-desc {
    font-size: 0.91rem;
    line-height: 1.58;
    color: var(--sl-color-gray-2);
    margin: 0 0 0.45rem 0;
  }
  .workflow-code {
    display: block;
    padding: 0.45rem 0.75rem;
    margin-top: auto;
    border-radius: 8px;
    background: var(--gg-term-bg);
    color: var(--gg-term-text);
    font-size: 0.78rem;
    overflow-x: auto;
    white-space: nowrap;
  }
  .workflow-cta {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--sl-color-accent);
    margin-top: 0.35rem;
  }

  @media (max-width: 760px) {
    .workflows-grid { grid-template-columns: minmax(0, 1fr); }
    .whats-new-title { font-size: 1.75rem; }
  }
</style>
