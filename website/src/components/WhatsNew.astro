---
// Bump `release` and edit `items` for each release.
const release = 'v1.4';
const tagline = 'AI agents can now run load tests — with limits you set.';

const items = [
  {
    icon: '🤖',
    title: 'gg mcp for AI agents',
    desc: 'Claude Code, Cursor, VS Code and JetBrains agents can validate a .http file, dry-run it, start a load test, read live telemetry, steer the rate and stop — all through ten MCP tools.',
    href: '/mcp',
    cta: 'Set it up',
  },
  {
    icon: '🛡',
    title: 'Safe by default',
    desc: 'Hard caps on RPS, duration and concurrent runs, an optional host allowlist, secrets masked in dry runs, and HTTP mode that refuses to listen beyond loopback without a token.',
    href: '/mcp#safety',
    cta: 'Read the safety rules',
  },
  {
    icon: '🔍',
    title: 'Judge the result',
    desc: 'Agents compare a run with a baseline snapshot using the same thresholds as gg snap assert, and the result says when traffic was steered by hand.',
    href: '/mcp-tools#snap_diff',
    cta: 'See snap_diff',
  },
  {
    icon: '⏱',
    title: 'Marks keep their true time',
    desc: 'A mark can carry the moment it happened (elapsed_s), so a snapshot timeline stays accurate even when the command arrives late. Older clients keep working unchanged.',
    href: '/control-protocol',
    cta: 'Protocol reference',
  },
];
---
<section class="whats-new-section" aria-labelledby="whats-new-title">
  <div class="whats-new-header">
    <span class="whats-new-badge">New in {release}</span>
    <h2 class="whats-new-title" id="whats-new-title">What's new</h2>
    <p class="whats-new-subtitle">{tagline}</p>
  </div>
  <div class="whats-new-grid">
    {items.map((item) => (
      <a href={item.href} class="whats-new-card">
        <div class="whats-new-icon" aria-hidden="true">{item.icon}</div>
        <h3 class="whats-new-card-title">{item.title}</h3>
        <p class="whats-new-card-desc">{item.desc}</p>
        <span class="whats-new-cta">{item.cta} &rarr;</span>
      </a>
    ))}
  </div>
</section>

<style>
  .whats-new-section {
    max-width: 900px;
    margin: 0 auto 2.5rem auto;
    padding: 0 1.5rem;
  }
  .whats-new-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .whats-new-badge {
    display: inline-block;
    padding: 0.2rem 0.75rem;
    margin-bottom: 0.75rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 999px;
    background: var(--gg-glass-bg);
    color: var(--sl-color-accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .whats-new-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--sl-color-text);
    margin: 0 0 0.5rem 0;
  }
  .whats-new-subtitle {
    color: var(--sl-color-gray-2);
    font-size: 1rem;
    max-width: 520px;
    margin: 0 auto;
  }
  .whats-new-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .whats-new-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.4rem 1.25rem;
    background: var(--gg-glass-bg);
    backdrop-filter: blur(12px);
    border: 1px solid var(--gg-glass-border);
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    box-shadow: 0 4px 20px var(--gg-glass-shadow);
  }
  .whats-new-card:hover,
  .whats-new-card:focus-visible {
    transform: translateY(-5px);
    box-shadow: 0 12px 40px var(--gg-glass-shadow-hover);
    border-color: var(--sl-color-accent);
  }
  .whats-new-icon {
    font-size: 1.75rem;
    line-height: 1;
  }
  .whats-new-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--sl-color-text);
    margin: 0.25rem 0 0 0;
  }
  .whats-new-card-desc {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
    margin: 0 0 0.75rem 0;
  }
  .whats-new-cta {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--sl-color-accent);
    margin-top: auto;
  }
  @media (max-width: 640px) {
    .whats-new-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
