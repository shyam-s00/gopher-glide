---
const rows = [
  {
    feature: 'Scripting',
    gg: 'None (Reuses .http files natively)',
    k6: 'JavaScript / Python',
    wrk: 'None (CLI flags only)',
  },
  {
    feature: 'Finding the limit',
    gg: 'Built-in Autopilot (--autopilot find-ceiling & slo-guard)',
    k6: 'Hand-write ramp scripts & read graphs',
    wrk: 'Re-run manually at higher concurrency',
  },
  {
    feature: 'IDE Experience',
    gg: 'Native JetBrains & VS Code Run Dashboard + Diff UI',
    k6: 'Terminal / Web cloud only',
    wrk: 'Terminal only',
  },
  {
    feature: 'AI Agents',
    gg: 'Built-in MCP (11 tools) & ACP agent with hard safety caps',
    k6: 'Not built in',
    wrk: 'Not built in',
  },
  {
    feature: 'Live Traffic Control',
    gg: 'Live TUI, IDE panel, pinned rates, markers & stdin LCP',
    k6: 'Static stage configs',
    wrk: 'Fixed concurrency only',
  },
  {
    feature: 'Regression Gating',
    gg: 'Semantic JSON Schema Diffing + Array Bloat Detection',
    k6: 'Latency & error thresholds',
    wrk: 'Raw latency numbers only',
  },
  {
    feature: 'Shareable Reports',
    gg: 'Self-contained HTML & Markdown Mission Reports (free)',
    k6: 'Paid cloud dashboard or plugins',
    wrk: 'Raw stdout text',
  },
  {
    feature: 'Performance',
    gg: '30,000+ RPS · 40% less RAM than k6',
    k6: 'Medium-High',
    wrk: 'Extremely High',
  },
];
---
<div class="compare-section" id="compare">
  <h2>How does gg compare?</h2>
  <div class="compare-wrap">
    <table>
      <colgroup>
        <col style="width: 18%" />
        <col style="width: 34%" />
        <col style="width: 24%" />
        <col style="width: 24%" />
      </colgroup>
      <thead>
        <tr>
          <th>Feature</th>
          <th class="col-gg">Gopher-Glide (gg)</th>
          <th class="col-other">k6 / Locust</th>
          <th class="col-other">wrk / hey</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td><strong>{row.feature}</strong></td>
            <td class="cell-gg"><strong>{row.gg}</strong></td>
            <td class="cell-other">{row.k6}</td>
            <td class="cell-other">{row.wrk}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .compare-section {
    padding: 2.25rem 2rem;
  }
  h2 {
    font-size: 2.05rem;
    text-align: center;
    margin: 0 0 1.5rem 0 !important;
  }
  .compare-wrap {
    overflow-x: auto;
    background: var(--gg-glass-bg);
    backdrop-filter: blur(12px);
    border: 1px solid var(--gg-glass-border);
    border-radius: 12px;
    padding: 1.5rem 2rem;
    box-shadow: 0 8px 32px var(--gg-glass-shadow);
  }
  table {
    width: 100%;
    min-width: 640px;
    table-layout: fixed;
    border-collapse: collapse;
    text-align: left;
  }
  thead tr {
    border-bottom: 2px solid var(--sl-color-hairline);
  }
  th {
    padding: 1rem;
  }
  th.col-gg {
    color: var(--sl-color-accent);
    font-size: 1.1rem;
  }
  th.col-other {
    color: var(--sl-color-gray-3);
  }
  tbody tr {
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  tbody tr:last-child {
    border-bottom: none;
  }
  td {
    padding: 1.15rem 1rem;
    color: var(--sl-color-gray-3);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  td.cell-gg {
    color: var(--sl-color-text);
  }
</style>
